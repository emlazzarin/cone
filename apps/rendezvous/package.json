{
  "name": "@cone/rendezvous",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@cone/core": "workspace:*"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --outdir dist",
    "build:server": "bun build src/server.ts --target=bun --outfile dist/server.js",

{
  "name": "cone",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build:cli": "bun run scripts/build-cli.ts",
    "setup": "bun run scripts/setup.ts",
    "build": "bun run --cwd apps/web build && bun run --cwd apps/rendezvous build",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:rendezvous": "bun run --cwd apps/rendezvous dev",
    "test": "bun test",
    "test:live:xmtp": "bun run scripts/live-xmtp.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251121.0",
    "bun-types": "^1.3.2",
    "typescript": "^5.9.3"
  }
}

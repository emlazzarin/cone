{
  "name": "cone-of-silence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "examples/*"
  ],
  "scripts": {
    "build": "bun run --cwd apps/web build && bun run --cwd apps/rendezvous build",
    "dev:web": "bun run --cwd apps/web dev",
    "dev:rendezvous": "bun run --cwd apps/rendezvous dev",
    "test": "bun test",
    "test:live:xmtp": "bun run scripts/live-xmtp.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "@preact/preset-vite": "^2.10.2",
    "@vitejs/plugin-legacy": "^6.0.0",
    "@xmtp/browser-sdk": "^7.0.0",
    "@xmtp/node-bindings": ">=1.11.0-nightly <2.0.0-0",
    "@xmtp/node-sdk": ">=6.1.0-nightly <6.2.0",
    "preact": "^10.27.2",
    "viem": "^2.40.0",
    "vite": "^7.2.4",
    "wrangler": "^4.97.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251121.0",
    "bun-types": "^1.3.2",
    "typescript": "^5.9.3"
  }
}

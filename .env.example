# Cone root secret. Generate with:
#   bun run packages/cli/src/bin.ts keygen
COS_SECRET_KEY=cos_sk_v1_REPLACE_ME

# XMTP network: local, dev, or production.
XMTP_ENV=dev

# Optional CLI base dir for config/state. Useful for tests and isolated agent runs.
COS_HOME=./.cone

# Optional exact CLI state/config overrides.
# COS_STATE_PATH=./.cone/state.sqlite
# COS_CONFIG_PATH=./.cone/config.json

# CLI output: json or plain.
COS_OUTPUT=json

# Ephemeral code-pairing service.
COS_RENDEZVOUS_URL=http://localhost:8787

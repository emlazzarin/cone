# Local development overrides. Copy to .env and adjust.
#
# Bun auto-loads .env into every process launched FROM THIS DIRECTORY — the
# globally linked `cone` binary ignores it anywhere else. Real environment
# variables always beat this file. `cone config` shows the effective result.

# Keep repo-launched config and state in ./.cone (gitignored) instead of the
# real account locations (~/.config/cone, ~/.local/share/cone). This is the
# ONLY path override — one directory holds config.json and state.sqlite.
CONE_HOME=./.cone

# Use the ephemeral XMTP dev network for repo work. The shipping default is
# `production`, and identities are env-scoped — a dev identity can never
# touch the production account.
XMTP_ENV=dev

# Rendezvous service for pairing/invites (`bun run dev:rendezvous` serves it).
# CONE_RENDEZVOUS_URL=http://localhost:8787

# Secret for scripts/agents; beats the remembered config.json secret.
# CONE_SECRET_KEY=cone_sk_v1_...

# CLI output mode: json (default,
# CONE_OUTPUT=plain

# Web (Vite — read at BUILD time): rendezvous URL baked into the PWA bundle.
# VITE_CONE_RENDEZVOUS_URL=http://
